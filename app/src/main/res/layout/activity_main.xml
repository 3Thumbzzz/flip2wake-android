<?xml version="1.0" encoding="utf-8"?>
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:fitsSystemWindows="true">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:padding="20dp">

        <Switch
            android:id="@+id/serviceSwitch"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:minHeight="56dp"
            android:text="@string/service_switch"
            android:textSize="18sp" />

        <TextView
            android:id="@+id/statusText"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:paddingBottom="16dp"
            android:textSize="14sp" />

        <!-- Angle -->
        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:paddingTop="12dp"
            android:text="@string/angle_label"
            android:textSize="16sp"
            android:textStyle="bold" />
        <TextView
            android:id="@+id/angleValue"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:textSize="28sp" />
        <SeekBar
            android:id="@+id/angleSeek"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:minHeight="40dp" />
        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:alpha="0.7"
            android:text="@string/angle_help"
            android:textSize="13sp" />

        <!-- Time -->
        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:paddingTop="24dp"
            android:text="@string/time_label"
            android:textSize="16sp"
            android:textStyle="bold" />
        <TextView
            android:id="@+id/timeValue"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:textSize="28sp" />
        <SeekBar
            android:id="@+id/timeSeek"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:minHeight="40dp" />
        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:alpha="0.7"
            android:text="@string/time_help"
            android:textSize="13sp" />

        <!-- Live test -->
        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:paddingTop="24dp"
            android:text="@string/test_label"
            android:textSize="16sp"
            android:textStyle="bold" />
        <TextView
            android:id="@+id/testText"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:padding="12dp"
            android:textSize="16sp" />

        <!-- Permissions / reliability -->
        <Button
            android:id="@+id/batteryButton"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="24dp"
            android:text="@string/battery_button" />
        <TextView
            android:id="@+id/batteryHelp"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:alpha="0.7"
            android:text="@string/battery_help"
            android:textSize="13sp" />

        <Button
            android:id="@+id/fullScreenButton"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="12dp"
            android:text="Allow full-screen wake (fallback)" />
    </LinearLayout>
</ScrollView>
